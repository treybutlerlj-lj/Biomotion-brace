import csv
import math
import struct
import time
from collections import deque
from threading import Lock, Thread

from flask import Flask, jsonify, render_template

try:
    import smbus2
except ImportError:  # pragma: no cover
    smbus2 = None

# --- CONFIGURATION ---
ALPHA = 0.80
LOOP_TIME = 0.02
SMOOTHING_WINDOW = 10

FLEXION_WEIGHT = 0.6
VELOCITY_WEIGHT = 0.4
FLEXION_RISK_THRESHOLD = 30.0
HIGH_FLEXION_THRESHOLD = 60.0
VELOCITY_RISK_THRESHOLD = 120.0
HIGH_VELOCITY_THRESHOLD = 250.0


app = Flask(__name__)


def clamp(value, minimum, maximum):
    return max(minimum, min(maximum, value))


def calculate_risk_index(flexion_angle, angular_velocity):
    if flexion_angle <= 0 and angular_velocity <= 0:
        return 0.0

    normalized_flexion = clamp(flexion_angle / HIGH_FLEXION_THRESHOLD, 0.0, 1.0)
    normalized_velocity = clamp(angular_velocity / HIGH_VELOCITY_THRESHOLD, 0.0, 1.0)
    risk_index = (FLEXION_WEIGHT * normalized_flexion) + (VELOCITY_WEIGHT * normalized_velocity)
    return round(clamp(risk_index, 0.0, 1.0), 3)


class Driver:
    def __init__(self, address):
        self.address = address
        self.bus = None
        if smbus2 is None:
            return
        try:
            self.bus = smbus2.SMBus(1)
            self.bus.write_byte_data(self.address, 0x6b, 0x01)
        except Exception as exc:
            print(f"Error: Sensor {hex(address)} failed: {exc}")

    def get_data(self):
        if self.bus is None:
            return (0, 0, 0, 0, 0, 0)
        try:
            raw = self.bus.read_i2c_block_data(self.address, 0x3B, 14)
            values = struct.unpack('>hhhhhhh', bytes(raw))
            return (values[0] / 16384.0, values[1] / 16384.0, values[2] / 16384.0,
                    values[4] / 131.0, values[5] / 131.0, values[6] / 131.0)
        except Exception:
            return (0, 0, 0, 0, 0, 0)


class IMUSensor:
    def __init__(self, address: int, name: str):
        self.name = name
        self.sensor = Driver(address)
        self.angle_filtered = 0
        self.gyro_offset = 0
        self.baseline = 0
        self.last_time = time.time()
        self.av = 0
        self.max_flexion = 0
        self.av_max = 0

    def update(self):
        ax, ay, az, gx, gy, gz = self.sensor.get_data()
        self.av = gy
        acc_angle = math.degrees(math.atan2(math.sqrt(ax**2 + az**2), ay))

        dt = time.time() - self.last_time
        self.last_time = time.time()

        actual_gyro_rate = gx - self.gyro_offset
        self.angle_filtered = ALPHA * (self.angle_filtered + actual_gyro_rate * dt) + (1 - ALPHA) * acc_angle

    def calibrate(self):
        print(f"Calibrating {self.name}... Stay still.")
        sums = 0
        for _ in range(100):
            sums += self.sensor.get_data()[3]
            time.sleep(0.01)
        self.gyro_offset = sums / 100

    def set_baseline(self):
        self.baseline = self.angle_filtered

    def get_tilt(self):
        return self.angle_filtered - self.baseline


class KneeMonitor:
    def __init__(self):
        self.thigh = IMUSensor(0x68, "Thigh")
        self.shank = IMUSensor(0x69, "Shank")
        self.max_flexion = 0.0
        self.av_max = 0.0
        self.history = deque(maxlen=300)
        self.smoothing_list = deque(maxlen=SMOOTHING_WINDOW)
        self.start_t = time.time()
        self.latest = {
            "time": 0.0,
            "angle": 0.0,
            "velocity": 0.0,
            "max_flexion": 0.0,
            "av_max": 0.0,
            "risk_index": 0.0,
            "risk_level": "SAFE",
            "calibrated": False,
            "sensor_state": "initializing",
        }
        self.lock = Lock()
        self.running = True
        self.thread = None

    def calibrate(self):
        self.thigh.calibrate()
        self.shank.calibrate()
        for _ in range(100):
            self.thigh.update()
            self.shank.update()
            time.sleep(0.01)
        self.thigh.set_baseline()
        self.shank.set_baseline()
        self.latest["calibrated"] = True
        self.latest["sensor_state"] = "active"

    def sample(self):
        self.thigh.update()
        self.shank.update()

        raw_val = abs(self.thigh.get_tilt() - self.shank.get_tilt()) * 1.3
        diff_av = abs(self.thigh.av - self.shank.av)

        self.smoothing_list.append(raw_val)
        clean_angle = sum(self.smoothing_list) / len(self.smoothing_list)

        if clean_angle > self.max_flexion:
            self.max_flexion = clean_angle
        if diff_av > self.av_max:
            self.av_max = diff_av

        elapsed = time.time() - self.start_t
        risk_index = calculate_risk_index(clean_angle, diff_av)

        if risk_index < 0.30:
            risk_level = "SAFE"
        elif risk_index < 0.60:
            risk_level = "CAUTION"
        elif risk_index < 0.85:
            risk_level = "HIGH"
        else:
            risk_level = "CRITICAL"

        snapshot = {
            "time": round(elapsed, 2),
            "angle": round(clean_angle, 2),
            "velocity": round(diff_av, 2),
            "max_flexion": round(self.max_flexion, 2),
            "av_max": round(self.av_max, 2),
            "risk_index": round(risk_index, 2),
            "risk_level": risk_level,
            "calibrated": True,
            "sensor_state": "active",
        }

        self.latest = snapshot
        self.history.append([snapshot["time"], snapshot["angle"], snapshot["velocity"],
                             snapshot["max_flexion"], snapshot["av_max"], snapshot["risk_index"], risk_level])

    def loop(self):
        while self.running:
            self.sample()
            time.sleep(LOOP_TIME)

    def start(self):
        if self.thread is not None and self.thread.is_alive():
            return
        self.calibrate()
        self.thread = Thread(target=self.loop, daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False

    def get_status(self):
        with self.lock:
            data = dict(self.latest)
            data["history"] = list(self.history)
            return data


monitor = KneeMonitor()


@app.route('/')
def index():
    return render_template('index.html', status=monitor.get_status())


@app.route('/motion')
def motion():
    return render_template('motion.html', status=monitor.get_status())


@app.route('/risk')
def risk():
    return render_template('risk.html', status=monitor.get_status())


@app.route('/api/telemetry')
def telemetry():
    return jsonify(monitor.get_status())


@app.route('/api/export')
def export_csv():
    with open('knee_data.csv', 'w', newline='') as handle:
        writer = csv.writer(handle)
        writer.writerow(['Time', 'Angle', 'Diff_av', 'Max_flexion', 'Av_max', 'Risk Index', 'Risk Level'])
        writer.writerows(monitor.history)
    return jsonify({"status": "ok", "path": "knee_data.csv"})


if __name__ == '__main__':
    monitor.start()
    app.run(host='0.0.0.0', port=5000, debug=True)
