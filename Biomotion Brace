import smbus2
import struct
import time
import math
import csv
import matplotlib.pyplot as plt
import pandas as pd

# --- CONFIGURATION ---
ALPHA = 0.80         # Balanced for slow squats and fast landing jumps
LOOP_TIME = 0.02     # 50Hz clinical standard
SMOOTHING_WINDOW = 10 # Removes "jitter" from the knee brace fabric

class Driver:
    def __init__(self, address):
        self.address = address
        try:
            self.bus = smbus2.SMBus(1)
            self.bus.write_byte_data(self.address, 0x6b, 0x01) 
        except Exception as e:
            print(f"Error: Sensor {hex(address)} failed: {e}")

    def get_data(self):
        try:
            raw = self.bus.read_i2c_block_data(self.address, 0x3B, 14)
            v = struct.unpack('>hhhhhhh', bytes(raw))
            return (v[0]/16384.0, v[1]/16384.0, v[2]/16384.0, v[4]/131.0, v[5]/131.0, v[6]/131.0)
        except:
            return (0, 0, 0, 0, 0, 0)

class IMUsensor:
    def __init__(self, address: int, name: str):
        self.name = name
        self.sensor = Driver(address)
        self.angle_filtered = 0
        self.gyro_offset = 0
        self.baseline = 0
        self.last_time = time.time()

    def update(self):
        ax, ay, az, gx, gy, gz = self.sensor.get_data()
        
        # --- THE UNIVERSAL ORIENTATION FIX ---
        # Instead of guessing X or Y, we calculate the tilt of the 
        # primary gravity vector against the other two planes.
        # This is "rotation-independent".
        acc_angle = math.degrees(math.atan2(math.sqrt(ax**2 + az**2), ay))

        dt = time.time() - self.last_time
        self.last_time = time.time()

        actual_gyro_rate = gx - self.gyro_offset
        self.angle_filtered = ALPHA * (self.angle_filtered + actual_gyro_rate * dt) + (1 - ALPHA) * acc_angle

    def calibrate(self):
        print(f"Calibrating {self.name}... Stay still.")
        sums = 0
        for _ in range(100):
            sums += self.sensor.get_data()[3] 
            time.sleep(0.01)
        self.gyro_offset = sums / 100

    def set_baseline(self):
        self.baseline = self.angle_filtered

    def get_tilt(self):
        return self.angle_filtered - self.baseline

def main():
    thigh = IMUsensor(0x68, "Thigh")
    shank = IMUsensor(0x69, "Shank")

    thigh.calibrate()
    shank.calibrate()

    print("\n--- CLINICAL ZEROING ---")
    print("Stand straight. ZEROING IN 5 SECONDS...")
    time.sleep(5) # Extra time to let go of the keyboard and stand still
    
    for _ in range(100):
        thigh.update(); shank.update(); time.sleep(0.01)
        
    thigh.set_baseline(); shank.set_baseline()
    print(">>> SYSTEM ACTIVE <<<")

    history = []
    smoothing_list = []
    max_flexion = 0
    start_t = time.time()

    try:
        while True:
            thigh.update()
            shank.update()

            # Differential Logic: Finding the hinge opening
            raw_val = (abs(thigh.get_tilt() - shank.get_tilt())) * 1.3
            
            smoothing_list.append(raw_val)
            if len(smoothing_list) > SMOOTHING_WINDOW: smoothing_list.pop(0)
            clean_angle = sum(smoothing_list) / len(smoothing_list)

            if clean_angle > max_flexion: max_flexion = clean_angle

            elapsed = time.time() - start_t
            history.append([round(elapsed, 2), round(clean_angle, 2)])

            # Judge Feedback
            status = "!! RISK !!" if clean_angle < 30 and elapsed > 2 else "SAFE"
            print(f"Angle: {clean_angle:5.1f}° | Max: {max_flexion:5.1f}° | {status}", end='\r')
            time.sleep(LOOP_TIME)

    except KeyboardInterrupt:
        print(f"\nSaving to knee_data.csv and generating graph...")
        with open('knee_data.csv', 'w', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(['Time', 'Angle'])
            writer.writerows(history)
        
        # Automatic Graphing for the Poster
        try:
            df = pd.read_csv('knee_data.csv')
            plt.figure(figsize=(10, 5))
            plt.plot(df['Time'], df['Angle'], color='green', label='Knee Flexion')
            plt.axhline(y=30, color='red', linestyle='--', label='ACL Injury Risk Threshold')
            plt.title("ACL Fatigue Analysis - HOSA Project")
            plt.ylabel("Flexion (Degrees)")
            plt.xlabel("Time (s)")
            plt.legend()
            plt.grid(True, alpha=0.2)
            plt.savefig('acl_report.png')
            print("Graph successful: acl_report.png")
        except Exception as e:
            print(f"CSV saved, but graphing failed: {e}")

if __name__ == "__main__":
    main()
